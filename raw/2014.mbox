Hi Alex,
  you probably want the get.inducedSubgraph() function

# make a test graph
net<-network.initialize(6)
set.vertex.attribute(net,'type',c("A","A","A","B","B","B"))

# split it according to value of 'type' attribute
netA<-get.inducedSubgraph(net,v=which(net%v%'type'=='A'))
netB<-get.inducedSubgraph(net,v=which(net%v%'type'=='B'))
netA%v%'type'
[1] "A" "A" "A"
netB%v%'type'
[1] "B" "B" "B"

best,
