Hi Jacob,
  For me, the fastest way to do this would be to use the network data 
structure to do the translation:

# your example dataset
raw<-matrix(c("10","5",NA,"7","10","7",NA,"5","5","7"),nrow=5,ncol=2,byrow=T)
colnames(raw) <- c("ID of first person at event", "ID of second person 
at event")
rownames(raw) <-c("Event1","Event2","Event3","Event4","Event5")

raw
        ID of first person at event ID of second person at event
Event1 "10"                        "5"
Event2 NA                          "7"
Event3 "10"                        "7"
Event4 NA                          "5"
Event5 "5"                         "7"


# NOTE: this is assuming that that the ids in raw are not matrix ids.
# i.e. the value of 10 doesn't mean there are 10 isolated 7 isolates
# not recorded

# get the set of unique actor ids
ids<-unique(as.vector(raw[!is.na(raw)]))

# initialize a bipartite network data structure
# size of network = # actors + # events
# bipartite = number of actors
net<-network.initialize(nrow(raw)+length(ids),bipartite = length(ids))
# set the vertex names
network.vertex.names(net)<-c(ids,rownames(raw))

# set up the edges in the network data structure
for (r in seq_len(nrow(raw))){
   actors<-raw[r,!is.na(raw[r,])]
   # translate to network matrix ids
   actors<-match(actors,ids)
   # event network id is num actors + event num
   eventId<-length(ids)+r
   # create edges from actors to events
   add.edges(net,tail=actors,head=rep(eventId,length=length(actors)))
}

# plot the network to make sure it is correct
plot(net,displaylabels = TRUE)

# print it out as a bipartite network in standard actors X events format
as.matrix(net)

    Event1 Event2 Event3 Event4 Event5
10      1      0      1      0      0
5       1      0      0      1      1
7       0      1      1      0      1


best,
  -skye


