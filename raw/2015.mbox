>   # Returns the attributes from summary.network as a data.frame
>   #
>   # Args:
>   #   network: a statnet network object
>   #
>   # Returns:
>   #   A data.frame with num. vertices, directed, hyper, loops, multiple,
> edges
>   #   (missing and not), and density
>
>   require(statnet)
>   if (!is.network(net))
>     stop("netSummaryDf takes a statnet network object as an argument.")
>
>   out <- data.frame(
>       vertices = network.size(net),
>       directed = is.directed(net),
>       hyper = is.hyper(net),
>       loops = has.loops(net),
>       multiple = is.multiplex(net),
>       total.edges = network.edgecount(net, na.omit = FALSE),
>       missing.edges= network.naedgecount(net),
