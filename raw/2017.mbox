testANIMATION <- function(adjmlist = adjmlist, namelist = namelist, animation.mode = "kamadakawai", interval=1, aggregate.dur=1, rule="any") {
netlist = lapply(adjmlist, as.network.matrix, matrix.type='adjacency', directed=T, hyper=F, loops=F, multiple=F, bipartite=F, ignore.eval=F, names.eval="weight")
for (i in 1:(length(netlist))) {
network.vertex.names(netlist[[i]]) <- namelist
}

  net.dyn <- networkDynamic(network.list=netlist
  compute.animation(net.dyn, animation.mode = "kamadakawai",
                    slice.par=list(start=0, end=length(adjmlist), interval=1, aggregate.dur=1, rule='any'))
  render.d3movie(net.dyn, usearrows = F,
                 displaylabels = F, label=net.dyn %v% "vertex.names",
                 bg="#ffffff", vertex.border="#333333",
                 vertex.cex = function(slice){ degree(slice)*0.004},
                 vertex.col = "gold",
                 edge.lwd = 0.001*(net.dyn %e% "weight"),
                 edge.col = '#55555599',
                 vertex.tooltip = paste("<b>Name:</b>", (net.dyn %v% "vertex.names")),
                 edge.tooltip = paste("<b>edge weight:</b>", (net.dyn %e% "weight")),
                 launchBrowser=F, filename=paste("Spectral-Network", ".html", sep=""),
                 render.par=list(tween.frames = 30, show.time = F),
                 plot.par=list(mar=c(0,0,0,0)) )
}

testANIMATION(adjmlist = adjmlist, namelist = namelist, animation.mode = "kamadakawai", interval=1, aggregate.dur=1, rule="any")
